{
    "name": "drupal/config_pull",
    "description": "Pull Drupal configuration from a remote site without downloading the database.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/config_pull",
    "keywords": [
        "Drupal",
        "configuration",
        "config",
        "deployment",
        "sync",
        "remote"
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/config_pull",
        "source": "https://git.drupalcode.org/project/config_pull"
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10.3 || ^11"
    },
    "require-dev": {
        "drush/drush": "^13"
    },
    "suggest": {
        "drupal/config_split": "Lets the server expose only the slice of config that belongs to a given environment.",
        "drupal/config_ignore": "Lets the server hide specific config items from being transferred."
    },
    "extra": {
        "drupal": {
            "version": "1.0.x-dev",
            "datestamp": "1713350400"
        }
    }
}
