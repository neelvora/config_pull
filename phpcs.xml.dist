<?xml version="1.0"?>
<ruleset name="config_pull">
  <description>Drupal coding standards for config_pull, with documented exclusions.</description>

  <file>.</file>
  <exclude-pattern>vendor/</exclude-pattern>
  <exclude-pattern>node_modules/</exclude-pattern>

  <arg name="extensions" value="php,module,install,inc,test,profile,theme"/>
  <arg value="sp"/>
  <arg name="colors"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Project style: comments are written when they add meaning, not when a sniff demands one. -->
  <!-- These exclusions keep the codebase free of empty stub docblocks while leaving meaningful -->
  <!-- docblocks (class summaries, complex method contracts) in place. drupal.org reviewers can -->
  <!-- request reinstatement during the project application; this is the project default. -->
  <rule ref="Drupal.Commenting.DocComment.Empty">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.DocComment.MissingShort">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.FunctionComment.Missing">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.FunctionComment.MissingReturnComment">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.FunctionComment.MissingParamComment">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.FunctionComment.ParamMissingDefinition">
    <severity>0</severity>
  </rule>
  <rule ref="Drupal.Commenting.VariableComment.Missing">
    <severity>0</severity>
  </rule>

  <!-- fnmatch() is the correct primitive for glob-style only/exclude config name filters. -->
  <!-- Drupal flags it because of Windows edge cases; we do not run on Windows. -->
  <rule ref="Drupal.Functions.DiscouragedFunctions.Discouraged">
    <severity>0</severity>
  </rule>
</ruleset>
